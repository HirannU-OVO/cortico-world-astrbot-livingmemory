{
  "name": "cortico-world-astrbot-livingmemory",
  "version": "0.1.1",
  "type": "module",
  "description": "给 Coopanion 桌面宠物接入 AstrBot 的 LivingMemory 长期记忆：桌宠与 QQ 智能体共用一套记忆库与知识图谱。需要配合 AstrBot 侧 astrbot_plugin_livingmemory_bridge 使用。",
  "author": "HirannU",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "livingmemory",
    "memory",
    "companion",
    "astrbot",
    "external-setup"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "node --check src/index.ts"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "LivingMemory 桌宠直连",
    "describe": "describe.json",
    "tags": [
      "memory",
      "astrbot",
      "bridge"
    ]
  },
  "files": [
    "src",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+github.com/HirannU-OVO/cortico-world-astrbot-livingmemory.git"
  },
  "homepage": "https://github.com/HirannU-OVO/cortico-world-astrbot-livingmemory#readme",
  "bugs": {
    "url": "https://github.com/HirannU-OVO/cortico-world-astrbot-livingmemory/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
